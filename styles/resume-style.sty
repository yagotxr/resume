\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{../../styles/resume-style}[2026/11/12 Shared resume layout]

\usepackage[top=0.5in,bottom=0.5in,left=0.62in,right=0.62in]{geometry}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{hyperref}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{xcolor}
\usepackage{parskip}

\definecolor{accent}{HTML}{1A1A1A}
\definecolor{link}{HTML}{0056B3}
\hypersetup{
    colorlinks=true,
    urlcolor=link,
    pdfborder={0 0 0}
}

\pagestyle{empty}

\titleformat{\section}
    {\normalsize\bfseries\color{accent}}
    {}{0em}{}
    [\titlerule]
\titlespacing*{\section}{0pt}{7pt}{6pt}

\setlist[itemize]{
    leftmargin=14pt,
    itemsep=1.5pt,
    topsep=2pt,
    parsep=0pt
}

\newcommand{\job}[4]{%
    \textbf{#1} \hfill \textbf{#2}\\
    \textit{#3} \hfill \textit{#4}\\[-2pt]
}
